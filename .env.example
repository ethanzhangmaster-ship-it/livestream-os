# OBS WebSocket 配置
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your_obs_password

# 抖音 API 配置（可选，如果使用真实数据）
DOUYIN_API_KEY=your_api_key
DOUYIN_API_SECRET=your_api_secret
DOUYIN_ROOM_ID=your_room_id
DOUYIN_CALLBACK_PORT=3000
DOUYIN_CALLBACK_PATH=/live_data_callback

# 数据模式
USE_FAKE_DATA=true

# 监控配置
DASHBOARD_PORT=8080

# 日志级别
LOG_LEVEL=info
