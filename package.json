{
  "name": "livestream-os",
  "version": "0.1.0",
  "description": "Livestream Operating System - Attention-Native Runtime for Live Commerce",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "ts-node scripts/start-system.ts",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "fake-events": "ts-node scripts/fake-event-stream.ts",
    "validate-loop": "ts-node scripts/validate-closed-loop.ts",
    "test-obs": "ts-node scripts/test-obs-connection.ts",
    "test-obs-integration": "ts-node scripts/test-obs-integration.ts",
    "test-douyin": "ts-node scripts/test-douyin-integration.ts",
    "test-optimization": "ts-node scripts/test-optimization-loop.ts",
    "test-error-handling": "ts-node src/error-handling/test-error-handling.ts",
    "test-monitoring": "ts-node src/monitoring/test-monitoring.ts",
    "test-obs-recording": "ts-node scripts/test-obs-recording-streaming.ts",
    "test:benchmark": "ts-node tests/performance/benchmark.ts",
    "test:stress": "ts-node tests/performance/stress.ts",
    "test:stability": "ts-node tests/performance/stability.ts",
    "douyin-cloud:check": "bash scripts/douyin-cloud-deploy.sh check",
    "douyin-cloud:build": "bash scripts/douyin-cloud-deploy.sh build",
    "douyin-cloud:login": "bash scripts/douyin-cloud-deploy.sh login",
    "douyin-cloud:push": "bash scripts/douyin-cloud-deploy.sh push",
    "douyin-cloud:deploy": "bash scripts/douyin-cloud-deploy.sh deploy",
    "douyin-cloud:url": "bash scripts/douyin-cloud-deploy.sh url",
    "douyin-cloud:logs": "bash scripts/douyin-cloud-deploy.sh logs",
    "douyin-cloud:status": "bash scripts/douyin-cloud-deploy.sh status",
    "douyin-cloud:all": "bash scripts/douyin-cloud-deploy.sh all"
  },
  "keywords": [
    "livestream",
    "attention",
    "runtime",
    "obs",
    "douyin",
    "live-commerce"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "obs-websocket-js": "^5.0.5",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "xstate": "^5.11.0"
  }
}
}
